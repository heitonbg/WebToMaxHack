# ============================================
# ПЕРЕКЛЮЧАТЕЛЬ: mock / real API
# ============================================
# true  → моковые данные (в памяти, без сервера)
# false → реальный API (сервер + БД)
VITE_USE_MOCK=true

# Адрес API-сервера (используется только при VITE_USE_MOCK=false)
# Локально:
VITE_API_URL=http://localhost:3001
# На Vercel (для ngrok/Tuna):
# VITE_API_URL=https://your-tunnel.ngrok-free.app
# На Vercel (для Amvera):
# VITE_API_URL=https://your-project.amvera.io